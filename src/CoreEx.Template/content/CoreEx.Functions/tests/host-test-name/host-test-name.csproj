<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--#if shared-core-->
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="CoreEx.UnitTesting" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="UnitTestEx.Azure.Functions" />
    <PackageReference Include="UnitTestEx.NUnit" />
  </ItemGroup>
  <!--#else-->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="CoreEx.UnitTesting" Version="coreex-version" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Include="UnitTestEx.Azure.Functions" Version="6.0.0" />
    <PackageReference Include="UnitTestEx.NUnit" Version="6.0.0" />
  </ItemGroup>
  <!--#endif-->
  <ItemGroup>
    <ProjectReference Include="..\..\src\app-name.Functions\app-name.Functions.csproj" />
  </ItemGroup>
</Project>
