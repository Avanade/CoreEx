{
  "CoreEx": {
    "Host": {
      "SolutionName": "solution-parent-name",
      "DomainName": "domain-name",
      "Services": {
        "Interval": "00:00:00.500",
//#if implement-cosmos
        "CosmosOutboxRelay": {
          "ref-data": {
            "ServicesCount": 4
          }
        }
//#else
        "OutboxRelay": {
          "BatchSize": 10,
          "PerWorkerPartitionCount": 2,
          "LeaseDuration": "00:00:30",
          "BackoffDuration": "00:00:05",
          "ServicesCount": 4
        }
//#endif
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
