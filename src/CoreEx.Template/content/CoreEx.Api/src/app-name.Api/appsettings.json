{
  "CoreEx": {
    "Host": {
      "SolutionName": "solution-parent-name",
      "DomainName": "domain-name"
// #if (implement-sqlserver || implement-postgres) && outbox-enabled
      ,"Outbox": {
        "PartitionSize": 4
      }
// #endif
// #if implement-servicebus
      ,"ServiceBus": {
        "SessionIdPartitionSize": 4
      }
// #endif
    },
    "Events": {
      "Destination": "domain-parent-lower" // Topic/queue name.
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "*"
}
