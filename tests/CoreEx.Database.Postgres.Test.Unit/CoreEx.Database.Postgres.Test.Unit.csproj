<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="DbEx.Postgres" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="UnitTestEx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreEx.EntityFrameworkCore\CoreEx.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\CoreEx\CoreEx.csproj" />
    <ProjectReference Include="..\..\src\CoreEx.Data\CoreEx.Data.csproj" />
    <ProjectReference Include="..\..\src\CoreEx.Database\CoreEx.Database.csproj" />
    <ProjectReference Include="..\..\src\CoreEx.Database.Postgres\CoreEx.Database.Postgres.csproj" />
    <ProjectReference Include="..\CoreEx.Database.Postgres.Test.Console\CoreEx.Database.Postgres.Test.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CoreEx.Test.Unit\Operations\OperationScriptMigrationTestsBase.cs" Link="Operations\OperationScriptMigrationTestsBase.cs" />
    <Compile Include="..\CoreEx.Test.Unit\Operations\OperationScriptTestHelper.cs" Link="Operations\OperationScriptTestHelper.cs" />
    <Compile Include="..\CoreEx.Test.Unit\Operations\OperationScriptTestsBase.cs" Link="Operations\OperationScriptTestsBase.cs" />
    <Compile Include="..\CoreEx.Test.Unit\Operations\OperationStoreTestsBase.cs" Link="Operations\OperationStoreTestsBase.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\**\*" />
    <EmbeddedResource Include="Migrations\**\*" />
    <EmbeddedResource Include="Data\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="NUnit.Framework" />
    <Using Include="UnitTestEx" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.unittest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
