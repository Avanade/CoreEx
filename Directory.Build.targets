<Project>

  <!--
    Opt-in local inner-loop narrowing: when CoreExLocalTargetFramework is set (e.g. user environment variable
    CoreExLocalTargetFramework=net10.0), multi-targeted projects that include that framework build only it. Reduces
    local disk use and build time; CI and packing are never narrowed. Override for a full build with
    -p:CoreExLocalTargetFramework= (empty).
  -->
  <PropertyGroup Condition="'$(CoreExLocalTargetFramework)' != '' and '$(CI)' != 'true' and '$(_IsPacking)' != 'true' and '$(TargetFrameworks)' != '' and $([System.String]::Copy(';$(TargetFrameworks);').Contains(';$(CoreExLocalTargetFramework);'))">
    <TargetFrameworks>$(CoreExLocalTargetFramework)</TargetFrameworks>
  </PropertyGroup>

</Project>
