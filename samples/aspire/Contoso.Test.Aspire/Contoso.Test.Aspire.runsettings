<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Aspire starts each project resource with 'dotnet run' (no-build), which fails for the multi-targeted sample hosts unless a single
           framework is selected. samples\Directory.Build.props honours DOTNET_TARGET_FRAMEWORK; the launched hosts inherit it. -->
      <DOTNET_TARGET_FRAMEWORK>net10.0</DOTNET_TARGET_FRAMEWORK>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
