<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <!-- The Cosmos DB provisioning uses CosmosDbClientFactory (System.Text.Json-based serializer), so Newtonsoft.Json is not needed. -->
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Contoso.Products.Contracts\Contoso.Products.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Contoso.Orders.Contracts\Contoso.Orders.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Contoso.Shopping.Contracts\Contoso.Shopping.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Contoso.Customers.Contracts\Contoso.Customers.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Contoso.Customers.Database\Contoso.Customers.Database.csproj" />
    <ProjectReference Include="..\Contoso.Customers.Test.Common\Contoso.Customers.Test.Common.csproj" />
    <ProjectReference Include="..\Contoso.Orders.Test.Common\Contoso.Orders.Test.Common.csproj" />
    <ProjectReference Include="..\Contoso.Products.Test.Common\Contoso.Products.Test.Common.csproj" />
    <ProjectReference Include="..\Contoso.Shopping.Test.Common\Contoso.Shopping.Test.Common.csproj" />
    <ProjectReference Include="..\..\src\Contoso.Products.Infrastructure\Contoso.Products.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Contoso.Shopping.Infrastructure\Contoso.Shopping.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*" />
    <None Include="..\..\src\Contoso.Products.Api\appsettings.Development.json" Link="products-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json">
      <TargetPath>e2e-settings.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
