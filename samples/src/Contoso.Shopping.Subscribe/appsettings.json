{
  "CoreEx": {
    "Host": {
      "SolutionName": "Contoso",
      "DomainName": "Shopping",
      "Outbox": {
        "PartitionSize": 4
      },
      "ServiceBus": {
        "SessionIdPartitionSize": 4,
        "Destinations": {
          "contoso-products": {
            "SessionIdPartitionSize": 2
          }
        }
      }
    },
    "Events": {
      "Destination": "contoso" // Topic/queue name.
    }
  },
  "SendGrid": {
    "BaseAddress": "https://api.sendgrid.com/",
    "FromEmail": "orders@contoso.com",
    "FromName": "Contoso Shopping"
    // "ApiKey" is intentionally not set here; supply via user-secrets or an environment variable in each environment.
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
