{
  "CoreEx": {
    "Host": {
      "SolutionName": "Contoso",
      "DomainName": "Orders"
    },
    "Events": {
      "Destination": "contoso"
    }
  },
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "*"
}
