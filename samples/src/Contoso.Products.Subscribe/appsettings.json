{
  "CoreEx": {
    "Host": {
      "SolutionName": "Contoso",
      "DomainName": "Products",
      "Services": {
        "Interval": "00:00:00.500"
      },
      "Outbox": {
        "PartitionSize": 4
      },
      "ServiceBus": {
        "SessionIdPartitionSize": 4
      }
    },
    "Events": {
      "Destination": "contoso" // Topic/queue name.
    }
  },
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
