{
  "CoreEx": {
    "Host": {
      "SolutionName": "Contoso",
      "DomainName": "Shopping",
      "Outbox": {
        "PartitionSize": 4
      },
      "ServiceBus": {
        "SessionIdPartitionSize": 4,
        "Destinations": {
          "contoso-products": {
            "SessionIdPartitionSize": 2
          }
        }
      }
    },
    "Events": {
      "Destination": "contoso" // Topic/queue name.
    }
  },
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
