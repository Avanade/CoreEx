{
  "CoreEx": {
    "Host": {
      "SolutionName": "Contoso",
      "DomainName": "Customers"
    },
    "Events": {
      "Destination": "contoso" // Topic/queue name.
    }
  },
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
