{
  "CoreEx": {
    "Host": {
      "SolutionName": "Contoso",
      "DomainName": "Customers",
      "Services": {
        "CosmosOutboxRelay": {
          "customers": {
            "ServicesCount": 2,
            "PollInterval": "00:00:01",
            "BatchSize": 10
          },
          "ref-data": {
            "ServicesCount": 2,
            "PollInterval": "00:00:01",
            "BatchSize": 10
          }
        }
      },
      "ServiceBus": {
        "SessionIdPartitionSize": 4
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
